PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Cloud PostgreSQL (Neon / Supabase / Render / RDS ...). Takes priority over DB_* below.
# Example: postgresql://user:password@ep-xxxx.region.aws.neon.tech/portfolioiq?sslmode=require
DATABASE_URL=

# Local PostgreSQL fallback (only used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolioiq
DB_USER=postgres
DB_PASSWORD=postgres

# Analytics Service Configuration
ANALYTICS_SERVICE_URL=http://localhost:8000
